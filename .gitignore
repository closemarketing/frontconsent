#Wordpress
vendor/
node_modules/

# Numerous always-ignore extensions
*.log
*.zip
.DS_Store

# WPUnit
.phpunit.result.cache

# Minified build artifacts (see bin/build-assets.js) — generated by `npm run
# build` or the release workflow, never hand-edited, never required for
# local dev. Kept out of `main`; the deploy workflow generates them fresh
# before packaging a tagged release, and .distignore does NOT exclude them
# from that package.
assets/**/*.min.js
assets/**/*.min.css

# OS or Editor folders
._*.cache
