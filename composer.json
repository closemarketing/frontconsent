{
	"name": "close/frontconsent",
	"description": "Cookie consent banner for WordPress, compliant with the AEPD guide and GDPR/ePrivacy.",
	"homepage": "https://close.technology/",
	"license": "GPL-2.0-or-later",
	"config": {
		"platform": {
			"php": "7.4"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"phpcompatibility/phpcompatibility-wp": "^2",
		"sirbrillig/phpcs-variable-analysis": "^3",
		"wp-coding-standards/wpcs": "^3.2",
		"phpcsstandards/phpcsutils": "^1.x-dev",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^1.0",
		"phpstan/phpstan": "^2.1",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"phpstan/extension-installer": "^1.4",
		"wp-phpunit/wp-phpunit": "^7.1",
		"yoast/wp-test-utils": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"FrontConsent\\": "includes/"
		}
	},
	"scripts": {
		"format": "phpcbf --standard=phpcs.xml.dist",
		"lint": "phpcs --standard=phpcs.xml.dist",
		"phpstan": "phpstan analyse --memory-limit=2048M",
		"test": "phpunit",
		"test-debug": "XDEBUG_MODE=debug XDEBUG_TRIGGER=1 phpunit",
		"test-install": "bash bin/install-wp-tests.sh wordpress_tests root 'root' 127.0.0.1 latest"
	}
}
